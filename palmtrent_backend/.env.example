NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb://mongo:27017/palmtrent
JWT_SECRET=replace-with-a-long-random-secret
INTEGRATION_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://app.palmtrent.example
API_BASE_URL=https://api.palmtrent.example
CORS_ORIGINS=https://app.palmtrent.example,https://admin.palmtrent.example

# Required production providers
MAPBOX_ACCESS_TOKEN=

# Address search also queries OpenStreetMap (Nominatim), which has far better
# street coverage than Mapbox in Zimbabwe. Their usage policy requires a real
# contact address in the User-Agent. Set either of these; the contact email is
# used to build a default User-Agent.
NOMINATIM_CONTACT_EMAIL=
NOMINATIM_USER_AGENT=

# Emergency dispatch integration for accident/medical SOS forwarding.
# This can also be configured from Admin > Settings > Integration Keys.
OPENAPI_AFRICA_BASE_URL=https://backendservices.clicknpay.africa:2081
OPENAPI_AFRICA_PUBLIC_UNIQUE_ID=
OPENAPI_AFRICA_RETURN_URL=https://app.palmtrent.example/payment/return
OPENAPI_AFRICA_CURRENCY=USD
# Optional direct Paynow rail. ClicknPay/OpenAPI Africa is the primary hosted
# payment gateway, including EcoCash/OneMoney where enabled by the provider.
ENABLE_PAYNOW_DIRECT_RAIL=false
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_RESULT_URL=https://api.palmtrent.example/api/v1/payments/paynow/webhook
PAYNOW_RETURN_URL=https://app.palmtrent.example/payment/return

# Optional EcoCash Open API lookup for cash-at-agent payments.
# Keep ClicknPay/OpenAPI Africa as the normal checkout. These variables only
# verify cash deposits paid into PalmTrent's EcoCash merchant/biller account.
ECOCASH_OPENAPI_MODE=sandbox
ECOCASH_OPENAPI_BASE_URL=https://developers.ecocash.co.zw/api/ecocash_pay
ECOCASH_OPENAPI_STATUS_ENDPOINT=/api/v1/transaction/c2b/status/sandbox
ECOCASH_OPENAPI_API_KEY=
ECOCASH_OPENAPI_BEARER_TOKEN=
ECOCASH_MERCHANT_CODE=
ECOCASH_WEBHOOK_SECRET=
ECOCASH_RECONCILE_LIMIT=20
ECOCASH_RECONCILE_MIN_INTERVAL_MS=120000
ECOCASH_RECONCILE_DELAY_MS=750
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Testing-only bypass. Leave false/missing for real production phone verification.
DISABLE_SMS_DELIVERY=false
FIREBASE_SERVICE_ACCOUNT=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
EMAIL_SECURE=false

# Internal job runner authentication
INTERNAL_JOB_KEY=

# Storage adapters: local, s3, r2
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Required for STORAGE_DRIVER=r2. Example: https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=
STORAGE_BASE_URL=
# Malware scanner run against every upload. Command + args are supported,
# e.g. "clamscan --no-summary" (the file path is appended as the last argument).
# Set to "disabled" to explicitly turn scanning off. Required in production.
UPLOAD_SCAN_COMMAND=

# Production fallback overrides. Leave false/missing for normal production.
ALLOW_LOCAL_STORAGE_IN_PRODUCTION=false
ALLOW_LOCATION_FALLBACK_IN_PRODUCTION=false
ALLOW_ESTIMATED_DISTANCE_IN_PRODUCTION=false
